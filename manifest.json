{
  "manifest_version": 3,
  "name": "Uni-Assist 도우미",
  "version": "0.7.0",
  "description": "웹 업무 도우미 — 텍스트 추출·조합 복사, 사이트별 자동 로그인(AES-256-GCM·PC 간 동기화), OTP 인증기(TOTP·QR 스캔).",
  "minimum_chrome_version": "114",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Uni-Assist 도우미 (사이드 패널 열기)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "activeTab",
    "offscreen",
    "clipboardWrite",
    "clipboardRead",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
