{
  "manifest_version": 3,
  "name": "Uni-Assist 도우미",
  "version": "0.2.1",
  "description": "웹 업무 생산성을 돕는 도우미. 현재 기능: 여러 요소 텍스트 추출·정규식 변환·조합 복사, 허용 사이트 단축키 복사. (기능 추가 예정)",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Uni-Assist 도우미 (사이드 패널 열기)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "commands": {
    "copy-combined": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "조합 결과를 복사 (허용한 사이트에서만 동작)"
    }
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "activeTab",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
