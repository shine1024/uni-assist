{
  "manifest_version": 3,
  "name": "Uni-Assist 도우미",
  "version": "0.5.0",
  "description": "웹 업무 생산성을 돕는 도우미. 텍스트 추출(요소 선택·정규식 변환·조합 복사)과 사이트별 자동 로그인/로그아웃(AES-256-GCM 암호화·PC 간 동기화).",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Uni-Assist 도우미 (사이드 패널 열기)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "commands": {
    "copy-combined": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "조합 결과를 복사 (허용한 사이트에서만 동작)"
    },
    "auto-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "등록된 사이트에서 자동 로그인 (잠금 해제 필요)"
    }
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "activeTab",
    "offscreen",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
